#!/bin/sh
# Claude Code hook launcher of the NRG plugin (see hooks/hooks.json).
# Usage: nrg-hook pre-edit|post-edit   (the hook JSON arrives on stdin)
#
# Runs `nrg --claude-hook <mode>` for projects that use NRG and does nothing elsewhere:
# a project without *.src.md templates never starts a JVM.
#
# The hook runs in every project the user opens, including repositories they do not trust,
# so it never executes anything the project supplies (such as its ./nrgw wrapper): it uses
# the command in $NRG_HOOK_COMMAND, set by the user, or else `nrg` from PATH. Without
# either it is a no-op.
mode=$1
dir=${CLAUDE_PROJECT_DIR:-.}

if git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  templates=$(git -C "$dir" ls-files --cached --others --exclude-standard -- '*.src.md' 2>/dev/null | head -n 1)
else
  templates=$(find "$dir" -name '*.src.md' -not -path '*/node_modules/*' 2>/dev/null | head -n 1)
fi
[ -n "$templates" ] || exit 0

if [ -n "$NRG_HOOK_COMMAND" ]; then
  # Word-split on purpose: the variable holds a command line such as "java -jar /opt/nrg/nrg.jar".
  # shellcheck disable=SC2086
  set -- $NRG_HOOK_COMMAND
elif command -v nrg >/dev/null 2>&1; then
  set -- nrg
else
  exit 0
fi

cd "$dir" || exit 0
exec "$@" --claude-hook "$mode"
